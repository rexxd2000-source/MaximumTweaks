# Copy this file to `.env` and fill in your real values.
# The `.env` file is ignored by git and MUST never be committed.
#
# Discord application: https://discord.com/developers/applications

DISCORD_CLIENT_ID=1536952165892096122
DISCORD_CLIENT_SECRET=keCQM5Pdn8crkqj7z9QCJ7tijhtLdvh7

# Public URL of THIS backend that Discord will redirect to after login.
# Must match the Redirect URI registered in the Discord portal EXACTLY
# (scheme, host, port and path — no trailing slash).
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/auth/discord/callback

# REX TWEAKS Discord server + Verified role ids.
DISCORD_GUILD_ID=1536946276002955324
DISCORD_ROLE_ID=1536960436413407312

# Bot token for the REX TWEAKS bot (Discord Developer Portal -> Bot -> Token).
# The bot MUST be in the server with a role ABOVE "Verified" and the
# "Manage Roles" permission: it adds arriving users (guilds.join) and assigns
# the Verified role. This is a secret — keep it only in .env.
DISCORD_BOT_TOKEN=your_discord_bot_token