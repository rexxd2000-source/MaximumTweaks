# Copy this file to `.env` and fill in real values (or generate fresh ones
# with `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# The `.env` file is ignored by git and MUST never be committed or bundled
# into the desktop EXE.

# Signs every session token (HMAC-SHA256). Server-side only. Generate a
# random value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LICENSE_SECRET=

# Bearer token guarding the /admin/* endpoints and unlocking the admin panel
# login. Generate a random value:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# Public URL of the license backend, consumed by the admin PowerShell tool
# (auth_backend\generate_keys.ps1). Kept in .env on purpose - never hardcoded
# or committed.
LICENSE_API_URL=

# Key prefix for newly generated licenses: 1-4 letters/digits (MAX/REX/MTW...).
# The key format stays XXXX-XXXX-XXXX-XXXX; the prefix is just the first group.
LICENSE_KEY_PREFIX=MAX

# How long an admin-panel login session lasts (hours) before the signed
# HttpOnly cookie expires.
ADMIN_SESSION_HOURS=12

# Where the license database lives.
# - Local dev (no DATABASE_URL): SQLite at auth_backend/licenses.db
#   (optional override: LICENSE_DB_PATH=/path/to/licenses.db)
# - Production on Render: set DATABASE_URL to your Neon PostgreSQL
#   connection string so licenses survive restarts/redeploys without a
#   persistent disk. The connection string is server-side only - never
#   commit it or bundle it into the desktop app.
DATABASE_URL=

# TESTS ONLY. Dedicated throwaway PostgreSQL database (e.g. a
# 'maximumtweaks_test' schema/database on Neon). The test suite wipes its
# licenses table - never point this at the production database.
# TEST_DATABASE_URL=

# Session token lifetime (hours). Short-lived on purpose.
SESSION_TTL_HOURS=72

# How long the desktop app may keep working offline after a token expires.
# The backend stays the authority: every online launch re-validates.
OFFLINE_GRACE_HOURS=24

# Activation rate limits (per hour).
ACTIVATE_PER_KEY=10
ACTIVATE_PER_IP=40

# ------------------------------------------------------ Ultra Mode waitlist
# Emails are collected from the desktop dashboard's "Join the waitlist" button
# and stored in the same DB. The launch email is sent from
# maxoptimizations@gmail.com through a swappable provider:
#
#   WAITLIST_MAILER=log      (default) write every send to the log, send nothing
#   WAITLIST_MAILER=smtp     real delivery (any SMTP provider; Gmail app passwords work)
#   WAITLIST_MAILER=resend   Resend HTTP API (best deliverability for a launch blast)
#
# SMTP settings are server-side only and never bundled into the desktop app.
WAITLIST_MAILER=log
WAITLIST_SMTP_HOST=
WAITLIST_SMTP_PORT=587
WAITLIST_SMTP_USER=
WAITLIST_SMTP_PASSWORD=
# For WAITLIST_MAILER=resend: the API key (format re_...). Set this ONLY in the
# server env / .env — it is a live credential and must never be committed.
WAITLIST_RESEND_API_KEY=
# From-address. NOTE: for smtp=maxoptimizations@gmail.com works; for resend the
# address must be on a domain you verified in Resend (e.g.
# "Maximum Optimizations <news@max-opti.co.za>") — Resend rejects gmail.com.
WAITLIST_FROM_EMAIL=maxoptimizations@gmail.com

# Launch email copy. Empty here = built-in defaults; the admin send-launch
# endpoint can also override per-broadcast.
# WAITLIST_SUBJECT=
# WAITLIST_HEADING=
# WAITLIST_MESSAGE=
# WAITLIST_CTA=
# WAITLIST_CTA_URL=
# WAITLIST_BASE_URL=

# Waitlist sign-ups allowed per IP per hour.
WAITLIST_JOIN_PER_IP=20

# Discord OAuth admin login (the web admin panel signs in via Discord).
# 1. Create an application at https://discord.com/developers/applications
#    -> OAuth2, scope "identify".
# 2. Add a redirect URI:  https://<your-domain>/admin/discord/callback
#    (on Render that's https://maximumtweaks.onrender.com/admin/discord/callback)
# 3. Set the client id/secret below and the admin allowlist.
# The client secret stays server-side only and is never bundled into anything.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs allowed to sign in to the admin app.
DISCORD_ADMIN_IDS=
# Optional "id:Display Name" pairs, comma-separated, for friendly labels.
# Example: 123456789012345678:Reaper,987654321098765432:Rex
DISCORD_ADMIN_NAMES=
# Optional redirect URL override. Defaults to <server base>/admin/discord/callback.
# DISCORD_REDIRECT=

# ---------------------------------------------------------------------------
# Web admin panel (SPA): build with `cd ../rex-tweaks-ui && npm run build`,
# then copy `dist/*` into `auth_backend/web/` and commit. The backend serves
# it at "/" and mounts /assets. The SPA needs no extra env vars - it talks to
# the /admin/* JSON endpoints with the session cookie from either login.
# ---------------------------------------------------------------------------
