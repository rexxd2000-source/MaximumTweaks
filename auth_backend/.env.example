# Copy this file to `.env` and fill in real values (or generate fresh ones
# with `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# The `.env` file is ignored by git and MUST never be committed or bundled
# into the desktop EXE.

# Signs every session token (HMAC-SHA256). Server-side only. Generate a
# random value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
LICENSE_SECRET=

# Bearer token guarding the /admin/* endpoints. Generate a random value:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# Where the license database lives. On Render, point this at a Persistent
# Disk so licenses survive restarts/redeploys, e.g.:
#   LICENSE_DB_PATH=/var/data/licenses.db
# Local default (when unset): auth_backend/licenses.db
# LICENSE_DB_PATH=

# Session token lifetime (hours). Short-lived on purpose.
SESSION_TTL_HOURS=72

# How long the desktop app may keep working offline after a token expires.
# The backend stays the authority: every online launch re-validates.
OFFLINE_GRACE_HOURS=24

# Activation rate limits (per hour).
ACTIVATE_PER_KEY=10
ACTIVATE_PER_IP=40
