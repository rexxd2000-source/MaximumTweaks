# Maximum Tweaks environment variable reference.
# Copy to `.env` (or set these in your runtime environment / packaging
# pipeline) and fill in real values. `.env` is gitignored and must never be
# committed. The app reads these variables directly from the environment.

# Both AI keys are OPTIONAL - with neither set, the AI Assistant falls back
# to the built-in offline demo router.

# Google Gemini API key (primary AI provider when set).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq API key (OpenAI-compatible endpoint; used when Gemini is unset).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
