{
  "name": "max-manager",
  "version": "1.0.0",
  "description": "Max Manager license admin for Maximum Tweaks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.maximumtweaks.maxmanager",
    "productName": "Max Manager",
    "files": [
      "main.js"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "MaxManager.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
